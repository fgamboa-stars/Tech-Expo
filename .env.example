# ============================================================================
# Heritage at Risk — environment variables
# Copy this file to `.env.local` and fill in values as needed.
# Every variable is OPTIONAL: the app runs with public, no-login services.
# Vite only exposes variables that start with VITE_ to the browser.
# ============================================================================

# ArcGIS Location Platform / ArcGIS Online API key.
# Optional. Without a key the app uses the public basemap items, which work
# for development and demos. Create one at https://location.arcgis.com/
VITE_ARCGIS_API_KEY=

# Override any hazard or landmark service URL (leave blank to use defaults in
# src/config/layers.ts). Useful if an agency moves a service.
VITE_NRHP_URL=
VITE_STATES_URL=
VITE_FEMA_FLOOD_URL=
VITE_NRI_TRACTS_URL=
VITE_WHP_URL=
VITE_SLR_BASE_URL=

# Max concurrent REST requests during live analysis (default 6).
VITE_ANALYSIS_CONCURRENCY=6
